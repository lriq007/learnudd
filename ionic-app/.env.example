# Copy this file to .env.local and fill in real values (never commit .env.local).
# Same Supabase project as the Next.js MVP — see notas/05-supabase.md.
#
# Project URL (Settings -> API -> Project URL). Just the base URL, e.g.
# https://xxxxxxxxxxxx.supabase.co -- @supabase/supabase-js builds the
# /rest/v1/, /auth/v1/, etc. paths itself.
SUPABASE_URL=

# Publishable/anon key only (Settings -> API). Never the secret/service_role
# key -- that one is never used by this client-side app.
SUPABASE_ANON_KEY=
